---
import type { Form as Props } from '~/types';
import Button from '~/components/ui/Button.astro';

const { inputs, textarea, disclaimer, button = 'Contact us', description = '', formName = 'contact' } = Astro.props;
---

<form name={formName} method="POST" data-netlify="true" enctype="multipart/form-data" action="/gracias">
  <input type="hidden" name="form-name" value={formName} />
  <input type="hidden" name="origen" value={formName} />
  {
    inputs?.map(
      ({ type = 'text', name, label = '', autocomplete = 'on', placeholder = '', required = false, accept, options }) =>
        name && (
          <div class="mb-6">
            {type === 'radio' && options ? (
              <fieldset class="mb-6">
                {label && <legend class="block text-sm font-medium mb-3 text-[#f5f0e7]">{label}</legend>}

                <div class="flex flex-wrap gap-3">
                  {options.map((option) => (
                    <label class="flex items-center gap-2 rounded-lg border border-[#d9cda7]/50 bg-[#f5f0e7] px-4 py-3 text-[#2f2921] cursor-pointer hover:border-[#a68d35] transition">
                      <input
                        type="radio"
                        name={name}
                        value={option.value}
                        required={required}
                        class="h-4 w-4 accent-[#a68d35]"
                      />
                      <span>{option.label}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            ) : (
              <>
                {label && (
                  <label for={name} class="block text-sm font-medium text-[#f5f0e7]">
                    {label}
                  </label>
                )}

                <input
                  type={type}
                  name={name}
                  id={name}
                  autocomplete={autocomplete}
                  placeholder={placeholder}
                  required={required}
                  accept={accept}
                  class="py-3 px-4 block w-full text-md rounded-lg border border-[#d9cda7]/50 bg-[#f5f0e7] text-[#2f2921] placeholder:text-[#7a6f60]/70 focus:border-[#a68d35] focus:outline-none"
                />
              </>
            )}
          </div>
        )
    )
  }

  {
    textarea && (
      <div>
        <label for="textarea" class="block text-sm font-medium">
          {textarea.label}
        </label>
        <textarea
          id="textarea"
          name={textarea.name ? textarea.name : 'message'}
          rows={textarea.rows ? textarea.rows : 4}
          placeholder={textarea.placeholder}
          class="py-3 px-4 block w-full text-md rounded-lg border border-[#d9cda7]/50 bg-[#f5f0e7] text-[#2f2921] placeholder:text-[#7a6f60]/70 focus:border-[#a68d35] focus:outline-none"
        />
      </div>
    )
  }

  {
    disclaimer && (
      <div class="mt-3 flex items-start">
        <div class="flex mt-0.5">
          <input
            id="disclaimer"
            name="disclaimer"
            type="checkbox"
            class="cursor-pointer mt-1 py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
          />
        </div>
        <div class="ml-3">
          <label for="disclaimer" class="cursor-pointer select-none text-sm text-gray-600 dark:text-gray-400">
            {disclaimer.label}
          </label>
        </div>
      </div>
    )
  }

  {
    button && (
      <div class="mt-10 grid">
        <Button variant="primary" type="submit">
          {button}
        </Button>
      </div>
    )
  }

  {
    description && (
      <div class="mt-3 text-center">
        <p class="text-sm text-gray-600 dark:text-gray-400">{description}</p>
      </div>
    )
  }
</form>
