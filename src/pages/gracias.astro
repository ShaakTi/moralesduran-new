---
import Layout from '~/layouts/PageLayout.astro';
import Museo from '~/assets/images/museo.png';
import Hero2 from '~/components/widgets/Hero2.astro';

const metadata = {
  title: 'Muchas gracias por tu interés',
};
---

<Layout metadata={metadata}>
  <!-- Hero2 Widget ******************* -->

  <Hero2
    tagline="Mensaje de Marco R. Morales"
    title="¡Gracias por comunicarte!"
    subtitle="<p>He recibido tu mensaje correctamente y haré todo lo posible por responderte pronto.</p><br><p>Aprecio mucho que te hayas tomado el tiempo de escribirme. Cada lector, visitante o viajero que llega hasta aquí forma parte de esta historia de una manera u otra.</p><br><p>Nos leemos pronto.</p><br>"
    actions={[
      { variant: 'secondary', text: 'Vuelta al inicio', href: '/', icon: 'tabler:square-rounded-arrow-right' },
    ]}
    image={{
      src: Museo,
      alt: 'Museo de Arte Colonial – Antigua Guatemala',
    }}
  />
</Layout>
