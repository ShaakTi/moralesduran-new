---
import Layout from '~/layouts/PageLayout.astro';
import Museo from '~/assets/images/museo.png';
import Hero2 from '~/components/widgets/Hero2.astro';

const metadata = {
  title: '¡Gracias por comunicarte!',
};
---

<Layout metadata={metadata}>
  <!-- Hero2 Widget ******************* -->

  <Hero2
    tagline="Mensaje de Marco R. Morales"
    title="¡Gracias por comunicarte!!"
    subtitle="<p>He recibido tu mensaje correctamente y haré todo lo posible por responderte pronto.</p><br><p>Aprecio mucho que te hayas tomado el tiempo de escribirme. Cada lector, visitante o viajero que llega hasta aquí forma parte de esta historia de una manera u otra.</p><br><p>Nos leemos en un momento.</p><br>"
    actions={[
      {
        variant: 'primary',
        text: 'Vuelta al inicio',
        href: '/index',
        icon: 'tabler:circle-arrow-right',
      },
    ]}
    image={{
      src: Museo,
      alt: 'Museo de Arte Colonial – Antigua Guatemala',
    }}
  />
</Layout>
