---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contacto" title="¡Comuniquémonos!" />

  <ContactUs
    id="form"
    formName="contacto"
    title="Déjame un mensaje"
    subtitle="Puedes encontrarme en las redes sociales y por otras vías, pero la más privada y la que siempre tengo en observación es mediante correo. Llena los siguientes espacios para que te responda lo más pronto que me sea posible."
    button="Enviar mensaje"
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Nombre',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
      },
    ]}
    textarea={{
      label: 'Mensaje',
    }}
    description="Usualmente respondo en el transcurso de 24 horas. Tu información será utilizada únicamente para responder a tu consulta. No compartiré tus datos con terceros ni los usaré para fines distintos a los relacionados con este sitio."
  />
</Layout>
