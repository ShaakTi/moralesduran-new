---
import Layout from '~/layouts/Layout.astro';

const title = `Error 404`;
---

<Layout metadata={{ title }}>
  <section class="flex items-center h-full p-16">
    <div class="container flex flex-col items-center justify-center px-5 mx-auto my-8">
      <div class="max-w-md text-center">
        <h2 class="mb-8 font-bold text-9xl">
          <span class="sr-only">Error</span>
          <span class="text-primary">404</span>
        </h2>
        <p class="text-3xl font-semibold md:text-3xl">Disculpa, no encontramos esta página, pero…</p>
        <p class="mt-4 mb-8 text-lg text-muted dark:text-slate-400">
          ¿Te gustaría mejor entrar a explorar la novela Mientras El Tiempo Se Detenga? ¿O quizás quieras descubrir el
          tour Celina's Enigma?
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/la-novela" class="btn">Descubre la novela</a>
          <a href="/celinas-enigma" class="btn">Descubre Celina's Enigma</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
